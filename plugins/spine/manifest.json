      {
        "id": "atlas",
        "entry": "thumbnail.html",
        "formats": ["atlas"],
        "companionFormats": ["png", "jpg", "jpeg"]
      }
    ],
    "viewers": [
      {
        "id": "atlas",
        "entry": "viewer.html",
        "formats": ["atlas"],
        "companionFormats": ["png", "jpg", "jpeg"]
      }
    ],
    "analyzers": [
      {
        "id": "atlas",
        "entry": "analyzer.html",
        "formats": ["atlas"]
      }
    ]
  }
}
