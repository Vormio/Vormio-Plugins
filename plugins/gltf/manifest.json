{
  "apiVersion": 4,
  "id": "vormio-plugins.gltf",
  "version": "0.4.1",
  "name": "glTF 模型",
  "description": "glTF 2.0 与 GLB 模型的缩略图、只读三维查看器（旋转、缩放、取景，显示配套贴图，播放动画，切换材质变体与文件中的相机）与组成分析（场景、网格、材质、贴图与引用的文件）。",
  "contributions": {
    "thumbnails": [
      {
        "id": "model",
        "entry": "thumbnail.html",
        "formats": ["gltf", "glb"],
        "companionFormats": ["bin", "png", "jpg", "jpeg", "webp", "avif", "ktx2"]
      }
    ],
    "viewers": [
      {
        "id": "model",
        "entry": "viewer.html",
        "formats": ["gltf", "glb"],
        "companionFormats": ["bin", "png", "jpg", "jpeg", "webp", "avif", "ktx2"]
      }
    ],
    "analyzers": [
      {
        "id": "model",
        "entry": "analyzer.html",
        "formats": ["gltf", "glb"]
      }
    ]
  }
}
